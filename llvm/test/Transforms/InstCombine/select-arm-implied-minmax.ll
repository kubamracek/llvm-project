; CHECK-LABEL: @udiv(
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[A:%.*]], 1
; CHECK-NEXT:    [[MX:%.*]] = call i32 @llvm.umax.i32(i32 [[A]], i32 1)
; CHECK-NEXT:    [[D:%.*]] = udiv i32 [[X:%.*]], [[MX]]
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[D]], i32 0
; CHECK-NEXT:    ret i32 [[R]]
;
  %c = icmp ugt i32 %a, 1
  %mx = call i32 @llvm.umax.i32(i32 %a, i32 1)
  %d = udiv i32 %x, %mx
  %r = select i1 %c, i32 %d, i32 0
