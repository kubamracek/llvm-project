; A min/max inside a select arm whose result is determined by the select
; condition is replaced by the operand it picks.

define i32 @smin_true_arm(i32 %x, i32 noundef %m) {
; CHECK-LABEL: @smin_true_arm(
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[M:%.*]], 0
; CHECK-NEXT:    [[N:%.*]] = sub i32 0, [[M]]
; CHECK-NEXT:    [[S:%.*]] = shl i32 [[X:%.*]], [[N]]
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; CHECK-NEXT:    ret i32 [[R]]
;
  %c = icmp slt i32 %m, 0
  %mn = call i32 @llvm.smin.i32(i32 %m, i32 0)
  %n = sub i32 0, %mn
  %s = shl i32 %x, %n
  %r = select i1 %c, i32 %s, i32 0
  ret i32 %r
}

define i32 @smax_true_arm(i32 %x, i32 noundef %m) {
; CHECK-LABEL: @smax_true_arm(
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[M:%.*]], 0
; CHECK-NEXT:    [[S:%.*]] = lshr i32 [[X:%.*]], [[M]]
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; CHECK-NEXT:    ret i32 [[R]]
;
  %c = icmp sgt i32 %m, 0
  %mx = call i32 @llvm.smax.i32(i32 %m, i32 0)
