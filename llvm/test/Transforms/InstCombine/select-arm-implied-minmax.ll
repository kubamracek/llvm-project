; The condition implies the min/max picks its RHS.
define i32 @smin_picks_rhs(i32 %x, i32 %m) {
; CHECK-LABEL: @smin_picks_rhs(
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[M:%.*]], 5
; CHECK-NEXT:    [[A:%.*]] = add i32 [[X:%.*]], 3
; CHECK-NEXT:    [[S:%.*]] = mul i32 [[A]], [[X]]
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; CHECK-NEXT:    ret i32 [[R]]
;
  %c = icmp sgt i32 %m, 5
  %mn = call i32 @llvm.smin.i32(i32 %m, i32 3)
  %a = add i32 %x, %mn
  %s = mul i32 %a, %x
  %r = select i1 %c, i32 %s, i32 0
  ret i32 %r
}

