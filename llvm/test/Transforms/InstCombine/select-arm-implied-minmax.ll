; Shuffles move values between lanes, so a lane's condition says nothing about
; the min/max that ends up in it.
define <2 x i32> @cross_lane(<2 x i32> %x, <2 x i32> noundef %m) {
; CHECK-LABEL: @cross_lane(
; CHECK-NEXT:    [[C:%.*]] = icmp slt <2 x i32> [[M:%.*]], zeroinitializer
; CHECK-NEXT:    [[MN:%.*]] = call <2 x i32> @llvm.smin.v2i32(<2 x i32> [[M]], <2 x i32> zeroinitializer)
; CHECK-NEXT:    [[SH:%.*]] = shufflevector <2 x i32> [[MN]], <2 x i32> poison, <2 x i32> <i32 1, i32 0>
; CHECK-NEXT:    [[S:%.*]] = shl <2 x i32> [[X:%.*]], [[SH]]
; CHECK-NEXT:    [[R:%.*]] = select <2 x i1> [[C]], <2 x i32> [[S]], <2 x i32> zeroinitializer
; CHECK-NEXT:    ret <2 x i32> [[R]]
;
  %c = icmp slt <2 x i32> %m, zeroinitializer
  %mn = call <2 x i32> @llvm.smin.v2i32(<2 x i32> %m, <2 x i32> zeroinitializer)
  %sh = shufflevector <2 x i32> %mn, <2 x i32> poison, <2 x i32> <i32 1, i32 0>
  %s = shl <2 x i32> %x, %sh
  %r = select <2 x i1> %c, <2 x i32> %s, <2 x i32> zeroinitializer
  ret <2 x i32> %r
}

