; A loop-carried value is frozen inside the loop, right after its definition.
define void @loop_carried(i32 %m0, i32 %x, ptr %np, ptr %out, i32 %len) {
;
; NOFREEZE-LABEL: @loop_carried(
; NOFREEZE-NEXT:  entry:
; NOFREEZE-NEXT:    br label [[LOOP:%.*]]
; NOFREEZE:       loop:
; NOFREEZE-NEXT:    [[M:%.*]] = phi i32 [ [[M0:%.*]], [[ENTRY:%.*]] ], [ [[M_NEXT:%.*]], [[LOOP]] ]
; NOFREEZE-NEXT:    [[I:%.*]] = phi i32 [ 0, [[ENTRY]] ], [ [[I_NEXT:%.*]], [[LOOP]] ]
; NOFREEZE-NEXT:    [[N:%.*]] = load i32, ptr [[NP:%.*]], align 4
; NOFREEZE-NEXT:    [[M1:%.*]] = sub nsw i32 [[M]], [[N]]
; NOFREEZE-NEXT:    [[C:%.*]] = icmp slt i32 [[M1]], 0
; NOFREEZE-NEXT:    [[MN:%.*]] = call i32 @llvm.smin.i32(i32 [[M1]], i32 0)
; NOFREEZE-NEXT:    [[NEG:%.*]] = sub nsw i32 0, [[MN]]
; NOFREEZE-NEXT:    [[S:%.*]] = shl i32 [[X:%.*]], [[NEG]]
; NOFREEZE-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; NOFREEZE-NEXT:    store i32 [[R]], ptr [[OUT:%.*]], align 4
; NOFREEZE-NEXT:    [[ADD:%.*]] = add nsw i32 [[M1]], 32
; NOFREEZE-NEXT:    [[M_NEXT]] = select i1 [[C]], i32 [[ADD]], i32 [[M1]]
; NOFREEZE-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; NOFREEZE-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[LEN:%.*]]
; NOFREEZE-NEXT:    br i1 [[DONE]], label [[EXIT:%.*]], label [[LOOP]]
; NOFREEZE:       exit:
; NOFREEZE-NEXT:    ret void
;
; FREEZE-LABEL: @loop_carried(
; FREEZE-NEXT:  entry:
; FREEZE-NEXT:    br label [[LOOP:%.*]]
; FREEZE:       loop:
; FREEZE-NEXT:    [[M:%.*]] = phi i32 [ [[M0:%.*]], [[ENTRY:%.*]] ], [ [[M_NEXT:%.*]], [[LOOP]] ]
; FREEZE-NEXT:    [[I:%.*]] = phi i32 [ 0, [[ENTRY]] ], [ [[I_NEXT:%.*]], [[LOOP]] ]
; FREEZE-NEXT:    [[N:%.*]] = load i32, ptr [[NP:%.*]], align 4
; FREEZE-NEXT:    [[M1:%.*]] = sub nsw i32 [[M]], [[N]]
; FREEZE-NEXT:    [[M1_FR:%.*]] = freeze i32 [[M1]]
; FREEZE-NEXT:    [[C:%.*]] = icmp slt i32 [[M1_FR]], 0
; FREEZE-NEXT:    [[NEG:%.*]] = sub nsw i32 0, [[M1_FR]]
; FREEZE-NEXT:    [[S:%.*]] = shl i32 [[X:%.*]], [[NEG]]
; FREEZE-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; FREEZE-NEXT:    store i32 [[R]], ptr [[OUT:%.*]], align 4
; FREEZE-NEXT:    [[ADD:%.*]] = add nsw i32 [[M1_FR]], 32
; FREEZE-NEXT:    [[M_NEXT]] = select i1 [[C]], i32 [[ADD]], i32 [[M1_FR]]
; FREEZE-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; FREEZE-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[LEN:%.*]]
; FREEZE-NEXT:    br i1 [[DONE]], label [[EXIT:%.*]], label [[LOOP]]
; FREEZE:       exit:
; FREEZE-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %m = phi i32 [ %m0, %entry ], [ %m.next, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %n = load i32, ptr %np
  %m1 = sub nsw i32 %m, %n
  %c = icmp slt i32 %m1, 0
  %mn = call i32 @llvm.smin.i32(i32 %m1, i32 0)
  %neg = sub nsw i32 0, %mn
  %s = shl i32 %x, %neg
  %r = select i1 %c, i32 %s, i32 0
  store i32 %r, ptr %out
  %add = add nsw i32 %m1, 32
  %m.next = select i1 %c, i32 %add, i32 %m1
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %len
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

