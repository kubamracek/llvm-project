; (transitive) user. If the condition may be undef,
; -cvp-freeze-for-select-conditions freezes the value it constrains, so that the
; condition and the folded instruction observe the same value.

; %m is loaded, so it may be undef.
define i32 @smin_load(i32 %x, ptr %p) {
