; NOFREEZE-LABEL: @smin_load(
; NOFREEZE-NEXT:    [[M:%.*]] = load i32, ptr [[P:%.*]], align 4
; NOFREEZE-NEXT:    [[C:%.*]] = icmp slt i32 [[M]], 0
; NOFREEZE-NEXT:    [[MN:%.*]] = call i32 @llvm.smin.i32(i32 [[M]], i32 0)
; NOFREEZE-NEXT:    [[S:%.*]] = shl nuw nsw i32 [[X:%.*]], [[MN]]
; NOFREEZE-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; NOFREEZE-NEXT:    ret i32 [[R]]
;
; FREEZE-LABEL: @smin_load(
; FREEZE-NEXT:    [[M:%.*]] = load i32, ptr [[P:%.*]], align 4
; FREEZE-NEXT:    [[M_FR:%.*]] = freeze i32 [[M]]
; FREEZE-NEXT:    [[C:%.*]] = icmp slt i32 [[M_FR]], 0
; FREEZE-NEXT:    [[S:%.*]] = shl nuw nsw i32 [[X:%.*]], [[M_FR]]
; FREEZE-NEXT:    [[R:%.*]] = select i1 [[C]], i32 [[S]], i32 0
; FREEZE-NEXT:    ret i32 [[R]]
;
  %m = load i32, ptr %p
  %c = icmp slt i32 %m, 0
  %mn = call i32 @llvm.smin.i32(i32 %m, i32 0)
  %s = shl i32 %x, %mn
  %r = select i1 %c, i32 %s, i32 0
  ret i32 %r
}

