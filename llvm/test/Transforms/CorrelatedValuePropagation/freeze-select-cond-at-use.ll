; FREEZE-NEXT:    [[NEED:%.*]] = sub nsw i32 0, [[AVAIL_FR]]
; FREEZE-NEXT:    [[W64:%.*]] = zext i32 [[W:%.*]] to i64
; FREEZE-NEXT:    [[NEED64:%.*]] = zext nneg i32 [[NEED]] to i64
; FREEZE-NEXT:    [[SHL:%.*]] = shl i64 [[W64]], [[NEED64]]
; FREEZE-NEXT:    [[ADD:%.*]] = select i1 [[CMP]], i64 [[SHL]], i64 0
; FREEZE-NEXT:    [[OR:%.*]] = or i64 [[ADD]], [[BITS:%.*]]
; FREEZE-NEXT:    ret i64 [[OR]]
